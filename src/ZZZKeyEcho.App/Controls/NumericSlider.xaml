<UserControl x:Class="ZZZKeyEcho.App.Controls.NumericSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Slider x:Name="SliderPart"
                Grid.Column="0"
                VerticalAlignment="Center"
                Minimum="{Binding Minimum, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Maximum="{Binding Maximum, RelativeSource={RelativeSource AncestorType=UserControl}}"
                TickFrequency="{Binding Step, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Value="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />

        <TextBox x:Name="TextPart"
                 Grid.Column="1"
                 Width="66"
                 Margin="8,0,0,0"
                 VerticalContentAlignment="Center"
                 TextChanged="OnTextChanged"
                 KeyDown="OnTextKeyDown"
                 LostFocus="OnTextCommit" />

        <TextBlock x:Name="SuffixPart"
                   Grid.Column="2"
                   Margin="6,0,0,0"
                   VerticalAlignment="Center"
                   Opacity="0.7" />
    </Grid>
</UserControl>
