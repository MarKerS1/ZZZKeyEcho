<Window x:Class="ZZZKeyEcho.App.Views.AlreadyRunningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZZZKeyEcho"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        Background="#FF171C21"
        Foreground="#FFF2F2F2"
        ShowInTaskbar="True">
    <StackPanel Margin="22">
        <TextBlock Text="已有实例正在运行"
                   FontSize="17"
                   FontWeight="Bold"
                   Margin="0,0,0,8" />
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Opacity="0.9" />
        <TextBlock TextWrapping="Wrap"
                   Opacity="0.65"
                   Margin="0,12,0,0"
                   Text="「关闭窗口」= 只退出这次启动，已有实例继续运行。&#10;「重启进程」= 结束所有已有实例，由本实例重新开始（推荐）。" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="关闭窗口" Padding="18,5" Margin="0,0,8,0" Click="OnCloseClick" />
            <Button Content="重启进程" Padding="18,5" IsDefault="True" Click="OnRestartClick" />
        </StackPanel>
    </StackPanel>
</Window>
